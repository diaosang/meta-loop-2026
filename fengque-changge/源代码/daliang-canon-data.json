      "id": "daliang:xie:comfort:0:0",
      "semantic": "daliang:xie:comfort:0:0",
      "npc": "xie",
      "category": "care",
      "topic": "comfort",
      "minTier": 0,
      "reply": "饭吃过了，夜里也能歇。奴才没有不适。"
    },
