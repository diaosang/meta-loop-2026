    {
      "id": "daliang:xu:recent:1:1",
      "semantic": "daliang:xu:recent:1:1",
      "npc": "xu",
      "category": "chat",
      "topic": "recent",
      "minTier": 1,
      "reply": "今日先收了卷。越是想一口气看明白，越容易将猜测看成事实。"
