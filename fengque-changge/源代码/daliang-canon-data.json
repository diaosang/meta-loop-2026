    {
      "id": "daliang:xu:recent:2:0",
      "semantic": "daliang:xu:recent:2:0",
      "npc": "xu",
      "category": "chat",
      "topic": "recent",
      "minTier": 2,
      "reply": "原想着将案上理妥再请您坐。看来若真等全理妥，今日又只能在殿上见了。"
