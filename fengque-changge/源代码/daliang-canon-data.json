    {
      "id": "daliang:xu:recent:2:1",
      "semantic": "daliang:xu:recent:2:1",
      "npc": "xu",
      "category": "chat",
      "topic": "recent",
      "minTier": 2,
      "reply": "书看得慢，倒不是不专心。是读到一处，总想问您会怎样看。"
