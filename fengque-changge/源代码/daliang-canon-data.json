      "id": "daliang:xie:comfort:0:2",
      "semantic": "daliang:xie:comfort:0:2",
      "npc": "xie",
      "category": "care",
      "topic": "comfort",
      "minTier": 0,
      "reply": "没有受凉。出入宫门，衣裳总会先添一件。"
    },
