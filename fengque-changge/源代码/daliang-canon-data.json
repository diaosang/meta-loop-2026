    {
      "id": "daliang:xu:home:0:0",
      "semantic": "daliang:xu:home:0:0",
      "npc": "xu",
      "category": "chat",
      "topic": "home",
      "minTier": 0,
      "reply": "祖父是陛下年少的老师。许家旧事，臣记得，案卷上却还有许多未核清。"
    },
    {
      "id": "daliang:xu:home:0:1",
      "semantic": "daliang:xu:home:0:1",
      "npc": "xu",
      "category": "chat",
      "topic": "home",
      "minTier": 0,
      "reply": "婚约解除已有数年。臣不会拿旧日约定，来索今日的回答。"
