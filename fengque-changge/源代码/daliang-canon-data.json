      "semantic": "daliang:xie:interest:1:0",
      "npc": "xie",
      "category": "chat",
      "topic": "interest",
      "minTier": 1,
      "reply": "话本里的人一眼便看透旁人，奴才倒想知道，他有没有看错过的那一回。"
