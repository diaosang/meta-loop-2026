      "id": "daliang:xie:comfort:1:1",
      "semantic": "daliang:xie:comfort:1:1",
      "npc": "xie",
      "category": "care",
      "topic": "comfort",
      "minTier": 1,
      "reply": "水记得趁温喝了，没回回都等它凉透。"
